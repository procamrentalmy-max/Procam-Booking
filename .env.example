# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the client / prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally,
# or the webhook's signing secret from the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp Business Cloud API (Meta) — the NotificationProvider implementation
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Must be a pre-approved template in Meta Business Manager (Authentication category for OTP).
WHATSAPP_OTP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Cron (Vercel automatically sends this as a Bearer token to /api/cron/* routes
# when it's set — see vercel.json)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Drone rental vertical — pickup-shop map (app/rent). Needs the Maps
# JavaScript API enabled on the key; without it the page still works, just
# falls back to a plain shop list with no map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# DEV ONLY — leave unset. Enables the "[DEV] Sign in as ProCam Admin" button
# on /login (app/login/devActions.ts), which mints a real session for this
# email without a password. Never set in production. Delete this var and
# app/login/devActions.ts before launch.
DEV_BYPASS_LOGIN_EMAIL=
